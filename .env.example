# Base URL of the Laravel API (no trailing slash). Copy this file to .env.local.
NEXT_API_URL=http://localhost:8000/api

# Currency used to display property prices (ISO 4217 code, e.g. USD, EUR, ETB).
NEXT_PUBLIC_CURRENCY=USD

# Time zone for dates and visit times (IANA name). Leave empty to use the machine's own zone.
# NEXT_PUBLIC_TIME_ZONE=Africa/Addis_Ababa
